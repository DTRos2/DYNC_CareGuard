[Unit]
Description=CareGuard R-07 uplink_node (robot -> server relay)
After=careguard-bringup-r07.service network-online.target
Wants=network-online.target
BindsTo=careguard-bringup-r07.service

[Service]
Type=simple
User=wego
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=1
Environment=CAREGUARD_ROBOT_CODE=R-07
Environment=CAREGUARD_SERVER_URL=http://192.168.230.7:8000
ExecStartPre=/bin/sleep 1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source ~/wego_ws/install/setup.bash && source ~/robot_careguard_ws/install/setup.bash && exec ros2 run careguard_agent uplink_node'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
