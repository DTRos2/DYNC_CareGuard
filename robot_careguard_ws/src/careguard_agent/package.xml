<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>careguard_agent</name>
  <version>0.1.0</version>
  <description>ROS2 ↔ FastAPI 브리지. 로봇에서 서버로 나가는 유일한 외부 통신구.</description>
  <maintainer email="careguard@example.com">CareGuard Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>careguard_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <depend>python3-requests</depend>
  <!-- save_map(map_saver_cli 실행)이 nav2_map_server를 서브프로세스로 부른다 —
       나머지 nav2 의존성은 careguard_bringup package.xml에 있다. -->
  <depend>nav2_map_server</depend>
  <!-- LIMO/wego 강의용 스택이 이미 설치되어 있다는 전제(로봇 쪽 ~/wego_ws에 실제로
       존재) — careguard_bringup package.xml의 같은 주석 참고. rosdep에 없을 수
       있어 빌드 실패시 무시해도 됨. /limo_status(battery_voltage) relay용. -->
  <exec_depend>limo_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
