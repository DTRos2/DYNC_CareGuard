# 순찰 1회차 실행. careguard_mission/patrol_task.py가 액션 서버,
# careguard_agent/downlink_node.py가 서버의 "patrol_start" WS 명령을 받아 호출하는
# 클라이언트다.
int32 run_id
Waypoint[] waypoints
# true: 다 돌면 충전 스테이션으로 복귀(원래 순찰 동작). false: 웨이포인트 하나로만
# 이동하고 도착한 자리에 머문다(P6 "이동" 단일 지점 주행용) — run_id=0으로 온다.
bool return_to_charging
# 0이면 "복약 전달" 경로가 아님(기존 순찰/이동 호출부는 그냥 안 채워서 기본값 0으로
# 온다 — 이 필드가 추가되기 전 호출부와 하위호환). 0보다 크면 patrol_schedule에
# 연결된 medication_schedule.id — patrol_task.py가 마지막 웨이포인트 도착 후(충전소
# 복귀 전) DeliverMedication 액션을 부를지 판단하는 유일한 근거다.
int32 medication_schedule_id
# medication_schedule.slot_no(1~3, DB CHECK 제약과 동일). medication_schedule_id가
# 0이면 의미 없음 — 그래도 같이 보내는 이유는 patrol_task.py가 DeliverMedication
# goal을 만들 때 medication_schedule 테이블을 다시 조회하지 않아도 되게 하려는
# 것(Waypoint.msg가 좌표를 직접 싣는 것과 같은 이유).
int32 slot_no
---
string status            # "completed" / "aborted" / "failed"
int32 waypoints_done
---
int32 waypoints_done
int32 waypoints_total
