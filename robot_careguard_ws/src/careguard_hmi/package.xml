<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>careguard_hmi</name>
  <version>0.1.0</version>
  <description>HMI 계층 — LCD 표정, LED, 스피커(음성 안내), 통화 등 사람과 로봇이 직접 마주하는 부분.</description>
  <maintainer email="careguard@example.com">CareGuard Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
