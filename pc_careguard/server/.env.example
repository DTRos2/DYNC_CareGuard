# app/config.py 가 읽는 값. 실제 값은 server/.env 로 복사해서 채우고,
# .env는 커밋하지 않는다 (CONVENTIONS.md 3.2). deploy/.env의 POSTGRES_* 값과 맞춘다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# ESP32 응급 호출 버튼 MQTT 브로커 주소. deploy/docker-compose.yml의 mosquitto를
# 로컬에서 그대로 쓰면 기본값(localhost:1883)으로 충분하다.
# 본인 PC가 mosquitto를 직접 띄우는 호스트가 아니라면(팀원 PC), localhost 대신
# 그 호스트 PC의 LAN IP로 바꿔야 한다 — 안 그러면 서버 기동 시 브로커 연결 실패로
# 기동 자체가 안 된다. POSTGRES_HOST를 원격 DB로 맞추는 것과 같은 원리.
MQTT_HOST=localhost
MQTT_PORT=1883
# 보호자 알림 메일 발송. NOTIFY_MODE=mock(기본값)이면 실제 발송 없이 notification_log만
# 남긴다 — CI/로컬 개발 안전망이니 기본값을 바꾸지 말 것. 실제 발송 테스트만 live로.
NOTIFY_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
