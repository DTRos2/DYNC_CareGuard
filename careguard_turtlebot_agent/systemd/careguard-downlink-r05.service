[Unit]
Description=CareGuard R-05 downlink_node (server -> robot commands: battery auto-return)
After=careguard-bringup-r05.service network-online.target
Wants=network-online.target
BindsTo=careguard-bringup-r05.service

[Service]
Type=simple
User=aurix
Environment=ROS_DOMAIN_ID=50
Environment=TURTLEBOT3_MODEL=burger
Environment=CAREGUARD_ROBOT_CODE=R-05
Environment=CAREGUARD_SERVER_URL=http://100.107.185.97:8000
ExecStartPre=/bin/sleep 1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source ~/turtlebot3_ws/install/setup.bash && source ~/medirun_ws/install/setup.bash && source ~/turtlebot_ws/install/setup.bash && exec ros2 run careguard_turtlebot_agent downlink_node'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
