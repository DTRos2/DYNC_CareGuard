[Unit]
Description=CareGuard R-05 camera (camera_ros/libcamera — 대시보드 카메라 미리보기용)
After=careguard-bringup-r05.service network-online.target
Wants=network-online.target
BindsTo=careguard-bringup-r05.service

[Service]
Type=simple
User=aurix
Environment=ROS_DOMAIN_ID=50
ExecStartPre=/bin/sleep 1
# format:=RGB888 필수 — R-06과 동일한 이유(NV21은 JPEG 인코더가 인식 못 함,
# careguard-camera-r06.service 주석 참고). 이 로봇의 libcamera(0.1)는 orientation
# 파라미터를 지원하지 않아("parameter 'orientation' not supported on libcamera 0.1",
# 2026-09-11 확인) 카메라가 뒤집혀 마운트된 것에 대한 보정은 여기서 안 하고
# uplink_node.py가 CAREGUARD_CAMERA_FLIP_VERTICAL=1로 소프트웨어에서 처리한다.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec ros2 launch camera_ros camera.launch.py camera:=0 format:=RGB888'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
