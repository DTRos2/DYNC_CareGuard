[Unit]
Description=CareGuard R-06 TurtleBot3 bringup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yeyu
Environment=ROS_DOMAIN_ID=40
Environment=TURTLEBOT3_MODEL=burger
Environment=LDS_MODEL=LDS-03
# usb_port를 /dev/ttyACM0 대신 by-id 고정 경로로 지정한다 — ttyACM0/1 번호는 USB
# 인식 순서로 정해져서, 이 로봇 PC에 꽂힌 다른 아두이노(DHT11 센서 브리지 등)가
# OpenCR보다 먼저 인식되면 OpenCR이 ttyACM1로 밀려나 turtlebot3_ros가 엉뚱한
# 장치(아두이노)에 계속 연결을 시도하다 죽는 문제가 실제로 있었다(2026-09-17,
# R-06 배터리/오도메트리/pose 전부 안 잡히는 증상으로 확인). by-id 경로는 장치
# 고유 시리얼 기준이라 꽂는 순서와 무관하게 항상 OpenCR만 가리킨다.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source ~/turtlebot3_ws/install/setup.bash && exec ros2 launch turtlebot3_bringup robot.launch.py usb_port:=/dev/serial/by-id/usb-ROBOTIS_OpenCR_Virtual_ComPort_in_FS_Mode_FFFFFFFEFFFF-if00'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
