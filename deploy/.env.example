# deploy/docker-compose.yml 이 읽는 값. 실제 값은 deploy/.env 로 복사해서 채우고,
# .env는 커밋하지 않는다 (CONVENTIONS.md 3.2).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 호스트에 노출할 포트. 5432는 다른 프로젝트 컨테이너가 점유할 수 있어 5433을 기본값으로 쓴다.
POSTGRES_PORT=5433
# ESP32 응급 호출 버튼 MQTT 브로커(mosquitto) 포트. 기본 1883 그대로 써도 대개 무방하다.
MQTT_PORT=1883
